# The floating latest tag, so a rebuild picks up the newest stable .NET SDK.
# Every alpine tag names a .NET version, so there is no alpine tag that
# floats, and this one is Debian based. It is published as an index holding
# real amd64 and arm64 layers, so each runner builds from binaries its own
# kernel can exec.
FROM mcr.microsoft.com/dotnet/sdk:latest
LABEL maintainer=jon@jaggersoft.com
